---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  quote: string;
  name: string;
  role: string;
  photo?: ImageMetadata;
}
const { quote, name, role, photo } = Astro.props;
const initials = name.split(' ').map((p) => p[0]).slice(0, 2).join('');
---

<figure class="rounded-2xl bg-ink p-8 text-white sm:p-10">
  <blockquote class="text-xl leading-relaxed font-medium sm:text-2xl">“{quote}”</blockquote>
  <figcaption class="mt-6 flex items-center gap-3">
    {
      photo ? (
        <Image src={photo} alt={name} width={48} height={48} class="size-12 rounded-full object-cover" />
      ) : (
        <span class="flex size-12 items-center justify-center rounded-full bg-white/10 font-semibold">{initials}</span>
      )
    }
    <span>
      <span class="block font-semibold">{name}</span>
      <span class="block text-sm text-white/60">{role}</span>
    </span>
  </figcaption>
</figure>
