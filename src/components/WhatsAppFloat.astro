---
import Icon from './Icon.astro';
import { whatsappLink } from '../lib/url';
---

<a
  href={whatsappLink()}
  target="_blank"
  rel="noopener"
  class="fixed right-4 bottom-4 z-50 flex items-center gap-2 rounded-full bg-[#1faa53] p-3.5 text-white shadow-lg shadow-black/10 transition-transform hover:scale-105 sm:right-6 sm:bottom-6 sm:px-5"
  aria-label="Chat with Emporia on WhatsApp"
>
  <Icon name="whatsapp" class="size-6" />
  <span class="hidden text-sm font-semibold sm:inline">WhatsApp us</span>
</a>
