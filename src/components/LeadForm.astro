---
import Icon from './Icon.astro';
import { site, industries, areas } from '../config/site';

interface Props {
  id?: string;
  compact?: boolean;
}
const { id = 'lead-form', compact = false } = Astro.props;
const keyConfigured = !site.web3formsKey.startsWith('TODO');

const field = 'mt-1.5 block w-full rounded-xl border border-line bg-white px-3.5 py-3 text-base text-ink placeholder:text-muted/70 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/15';
const label = 'text-sm font-medium text-ink';
const contactOptions = ['WhatsApp message', 'WhatsApp call', 'Phone call', 'Email'];
---

<div class="card p-5 sm:p-7" data-lead-root>
  <form
    id={id}
    class="grid gap-4"
    data-lead-form
    data-key={keyConfigured ? site.web3formsKey : ''}
    data-whatsapp={site.contact.whatsapp}
    novalidate
  >
    <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

    <div class:list={['grid gap-4', !compact && 'sm:grid-cols-2']}>
      <label class="block">
        <span class={label}>Your name</span>
        <input class={field} name="name" autocomplete="name" required placeholder="Rahul Sharma" />
      </label>
      <label class="block">
        <span class={label}>Phone / WhatsApp</span>
        <input class={field} name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder="98XXXXXXXX" pattern="(\+?91)?[6-9][0-9]{9}" />
      </label>
    </div>

    <div class:list={['grid gap-4', !compact && 'sm:grid-cols-2']}>
      <label class="block">
        <span class={label}>Business name</span>
        <input class={field} name="business" autocomplete="organization" required placeholder="Sharma Hardware" />
      </label>
      <label class="block">
        <span class={label}>Email <span class="font-normal text-muted">(optional)</span></span>
        <input class={field} name="email" type="email" autocomplete="email" placeholder="you@business.com" />
      </label>
    </div>

    <div class:list={['grid gap-4', !compact && 'sm:grid-cols-2']}>
      <label class="block">
        <span class={label}>Industry</span>
        <select class={field} name="industry" required>
          <option value="" disabled selected>Select…</option>
          {industries.map((i) => <option>{i}</option>)}
          <option>Other</option>
        </select>
      </label>
      <label class="block">
        <span class={label}>Area</span>
        <select class={field} name="area" required>
          <option value="" disabled selected>Select…</option>
          {areas.map((a) => <option>{a}</option>)}
        </select>
      </label>
    </div>

    <label class="block">
      <span class={label}>What do you need help with?</span>
      <textarea class={field} name="message" rows={compact ? 2 : 3} placeholder="e.g. More calls from Google Maps, more walk-ins, more admissions…"></textarea>
    </label>

    <fieldset>
      <legend class={label}>How should we contact you?</legend>
      <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4">
        {
          contactOptions.map((opt, i) => (
            <label class="flex cursor-pointer items-center justify-center rounded-xl border border-line px-2 py-2.5 text-center text-sm font-medium text-ink-soft transition-colors has-checked:border-brand has-checked:bg-brand-tint has-checked:text-brand">
              <input type="radio" name="preferred_contact" value={opt} class="sr-only" checked={i === 0} />
              {opt}
            </label>
          ))
        }
      </div>
    </fieldset>

    <p class="hidden rounded-xl bg-warn-tint px-3.5 py-2.5 text-sm text-warn" data-lead-error role="alert"></p>

    <button type="submit" class="btn-primary mt-1 w-full !py-3.5 text-base" data-lead-submit>
      Get my free local audit <Icon name="arrow" class="size-4" />
    </button>
    <p class="text-center text-xs text-muted">We reply within one working day. No spam, no sharing your number.</p>
  </form>

  <div class="hidden py-6 text-center" data-lead-success role="status" aria-live="polite">
    <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-good-tint text-good">
      <Icon name="check" class="size-6" />
    </div>
    <h3 class="mt-4 text-xl font-bold">Thanks — we've got your details.</h3>
    <p class="mx-auto mt-2 max-w-sm text-sm text-muted">We'll reach out the way you asked. Want to talk right now? Message us on WhatsApp.</p>
    <a href="#" class="btn-whatsapp mt-6" target="_blank" rel="noopener" data-lead-wa>
      <Icon name="whatsapp" class="size-5" /> Chat on WhatsApp now
    </a>
  </div>
</div>

<script>
  function waMessage(data: FormData): string {
    const lines = [
      'Hi Emporia, I just filled the form on your website.',
      `Name: ${data.get('name')}`,
      `Business: ${data.get('business')} (${data.get('industry')}, ${data.get('area')})`,
      data.get('message') ? `Need: ${data.get('message')}` : '',
      `Preferred contact: ${data.get('preferred_contact')}`,
    ];
    return lines.filter(Boolean).join('\n');
  }

  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
    const root = form.closest('[data-lead-root]')!;
    const errorBox = root.querySelector<HTMLElement>('[data-lead-error]')!;
    const success = root.querySelector<HTMLElement>('[data-lead-success]')!;
    const waBtn = root.querySelector<HTMLAnchorElement>('[data-lead-wa]')!;
    const submit = root.querySelector<HTMLButtonElement>('[data-lead-submit]')!;
    const key = form.dataset.key;
    const waNumber = form.dataset.whatsapp;

    const showError = (msg: string) => {
      errorBox.textContent = msg;
      errorBox.classList.remove('hidden');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      const phone = form.querySelector<HTMLInputElement>('[name="phone"]')!;
      phone.value = phone.value.replace(/[\s()-]/g, '');

      if (!form.checkValidity()) {
        const bad = form.querySelector<HTMLInputElement>(':invalid');
        bad?.focus();
        showError(bad?.name === 'phone' ? 'Please enter a valid 10-digit Indian mobile number.' : 'Please fill in the highlighted fields.');
        return;
      }

      const data = new FormData(form);
      if (data.get('botcheck')) return;
      const waHref = `https://wa.me/${waNumber}?text=${encodeURIComponent(waMessage(data))}`;
      waBtn.href = waHref;

      // No form backend configured yet: hand the enquiry straight to WhatsApp.
      if (!key) {
        window.open(waHref, '_blank', 'noopener');
        form.classList.add('hidden');
        success.classList.remove('hidden');
        return;
      }

      submit.disabled = true;
      submit.textContent = 'Sending…';
      try {
        const payload = Object.fromEntries(data.entries());
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            ...payload,
            access_key: key,
            subject: `New website lead: ${payload.business} (${payload.area})`,
            from_name: 'Emporia website',
            page: location.pathname,
          }),
        });
        const json = await res.json();
        if (!json.success) throw new Error(json.message);
        form.classList.add('hidden');
        success.classList.remove('hidden');
      } catch {
        showError('Something went wrong sending the form. ');
        const link = Object.assign(document.createElement('a'), { href: waHref, target: '_blank', rel: 'noopener', textContent: 'Send it on WhatsApp instead →' });
        link.className = 'font-semibold underline';
        errorBox.append(link);
        submit.disabled = false;
        submit.textContent = 'Try again';
      }
    });
  });
</script>
