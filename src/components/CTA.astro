---
import Icon from './Icon.astro';
import { url, whatsappLink, telLink } from '../lib/url';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Want results like these for your business?',
  text = 'Get a free local audit: where you rank on Google Maps today, what your competitors do better, and what we would fix first.',
} = Astro.props;
---

<section class="container-x">
  <div class="relative overflow-hidden rounded-3xl bg-ink px-6 py-12 text-white sm:px-12 sm:py-16">
    <div class="absolute -top-24 -right-24 size-72 rounded-full bg-gradient-to-br from-brand to-brand-sky opacity-40 blur-3xl" aria-hidden="true"></div>
    <div class="relative max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
      <p class="mt-4 text-white/70">{text}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={url('/contact/')} class="bg-white text-ink hover:bg-brand-tint inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-semibold">Get my free audit <Icon name="arrow" class="size-4" /></a>
        <a href={whatsappLink()} target="_blank" rel="noopener" class="btn-whatsapp"><Icon name="whatsapp" class="size-4" /> WhatsApp</a>
        <a href={telLink} class="inline-flex items-center gap-2 rounded-full border border-white/20 px-5 py-3 text-sm font-semibold hover:border-white"><Icon name="phone" class="size-4" /> Call us</a>
      </div>
    </div>
  </div>
</section>
