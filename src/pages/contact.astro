---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../config/site';
import { whatsappLink, telLink, mailLink } from '../lib/url';

const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(site.address.mapEmbedQuery)}&z=14&output=embed`;
---

<Base title="Contact" description={`Get a free local audit from Emporia, ${site.city}. WhatsApp, call or email us — we reply within one working day.`}>
  <section class="container-x grid gap-12 pt-14 lg:grid-cols-[1fr_1.3fr]">
    <div>
      <p class="eyebrow">Contact</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-5xl">Let's talk about your business.</h1>
      <p class="mt-5 text-lg text-ink-soft">Fill in the form for a free local audit, or reach us directly. We reply within one working day.</p>

      <div class="mt-10 space-y-3">
        <a href={whatsappLink()} target="_blank" rel="noopener" class="flex items-center gap-4 rounded-xl border border-line p-4 hover:border-ink">
          <span class="flex size-11 items-center justify-center rounded-full bg-[#1faa53] text-white"><Icon name="whatsapp" class="size-5" /></span>
          <span><span class="block font-semibold">WhatsApp chat or call</span><span class="block text-sm text-muted">Fastest way to reach us</span></span>
        </a>
        <a href={telLink} class="flex items-center gap-4 rounded-xl border border-line p-4 hover:border-ink">
          <span class="flex size-11 items-center justify-center rounded-full bg-ink text-white"><Icon name="phone" class="size-5" /></span>
          <span><span class="block font-semibold">Call</span><span class="num block text-sm text-muted">{site.contact.phoneDisplay}</span></span>
        </a>
        <a href={mailLink} class="flex items-center gap-4 rounded-xl border border-line p-4 hover:border-ink">
          <span class="flex size-11 items-center justify-center rounded-full bg-brand text-white"><Icon name="mail" class="size-5" /></span>
          <span><span class="block font-semibold">Email</span><span class="block text-sm text-muted">{site.contact.email}</span></span>
        </a>
      </div>

      <dl class="mt-10 space-y-4 text-sm">
        <div class="flex gap-3"><Icon name="pin" class="size-5 shrink-0 text-muted" /><div><dt class="font-semibold">Office</dt><dd class="text-ink-soft">{site.address.street}, {site.address.locality}, {site.address.region} {site.address.postalCode}</dd></div></div>
        <div class="flex gap-3"><Icon name="clock" class="size-5 shrink-0 text-muted" /><div><dt class="font-semibold">Hours</dt><dd class="text-ink-soft">{site.hours}</dd></div></div>
      </dl>
    </div>

    <div>
      <LeadForm id="contact-lead" />
    </div>
  </section>

  <section class="container-x mt-16">
    <iframe
      title={`Map showing Emporia in ${site.city}`}
      src={mapSrc}
      class="h-80 w-full rounded-2xl border border-line"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>
</Base>
