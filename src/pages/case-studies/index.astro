---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseStudyCard from '../../components/case-study/CaseStudyCard.astro';
import CTA from '../../components/CTA.astro';
import { site } from '../../config/site';

const entries = (await getCollection('caseStudies')).sort((a, b) => b.data.period.end.localeCompare(a.data.period.end));
const industries = [...new Set(entries.map((e) => e.data.industry))].sort();
---

<Base
  title="Case Studies"
  description={`Real results for real ${site.city} businesses — with the original screenshots, dates and sources behind every number.`}
>
  <section class="container-x pt-14 pb-10">
    <p class="eyebrow">Case studies</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">Our work, with the receipts.</h1>
    <p class="mt-5 max-w-2xl text-lg text-ink-soft">
      Every case study names the client, states where they started, and shows the original dashboard behind each result.
    </p>
  </section>

  <section class="container-x">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by industry" data-filters>
      <button type="button" class="filter-btn" data-filter="" aria-pressed="true">All</button>
      {industries.map((i) => <button type="button" class="filter-btn" data-filter={i} aria-pressed="false">{i}</button>)}
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-grid>
      {entries.map((e) => <CaseStudyCard entry={e} />)}
    </div>
    <p class="mt-8 hidden text-muted" data-empty>No case studies in this industry yet — <a class="font-medium text-brand underline" href="#" data-reset>show all</a>.</p>
  </section>

  <div class="mt-24"><CTA /></div>
</Base>

<style>
  @reference '../../styles/global.css';
  .filter-btn {
    @apply rounded-full border border-line px-4 py-2 text-sm font-medium text-ink-soft transition-colors hover:border-ink;
  }
  .filter-btn[aria-pressed='true'] {
    @apply border-ink bg-ink text-white;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-grid] > [data-industry]');
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;

  function apply(industry: string) {
    let shown = 0;
    cards.forEach((c) => {
      const match = !industry || c.dataset.industry === industry;
      c.hidden = !match;
      if (match) shown++;
    });
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === industry)));
    empty.classList.toggle('hidden', shown > 0);
    const params = new URLSearchParams(location.search);
    industry ? params.set('industry', industry) : params.delete('industry');
    history.replaceState(null, '', params.size ? `?${params}` : location.pathname);
  }

  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? '')));
  document.querySelector('[data-reset]')?.addEventListener('click', (e) => {
    e.preventDefault();
    apply('');
  });
  const initial = new URLSearchParams(location.search).get('industry');
  if (initial) apply(initial);
</script>
