---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import RevenueChart from '../components/case-study/RevenueChart.astro';
import CaseStudyCard from '../components/case-study/CaseStudyCard.astro';
import { site, industries, services } from '../config/site';
import { url, whatsappLink, telLink, mailLink } from '../lib/url';

const all = (await getCollection('caseStudies')).sort((a, b) => b.data.period.end.localeCompare(a.data.period.end));
const featured = all.find((c) => c.data.featured) ?? all[0];
const others = all.filter((c) => c.id !== featured?.id).slice(0, 3);

const principles = [
  { title: 'Real clients, by name', text: 'Every case study names the business and links to it. No “a leading brand in NCR”.' },
  { title: 'The original screenshot', text: 'Numbers come with the dashboard they came from — GA4, Google Business Profile, POS. Anything hidden is listed.' },
  { title: 'Start, end and source', text: 'Every result shows where the client started, the exact dates, and where the number came from.' },
];

const steps = [
  { n: '01', title: 'Free local audit', text: 'Where you rank on Google Maps today, street by street, and what your competitors do better.' },
  { n: '02', title: 'A 90-day plan', text: 'Three to five priorities, in order, with the numbers we expect to move.' },
  { n: '03', title: 'We do the work', text: 'Profile, pages, reviews, ads — handled by us, with a weekly update on WhatsApp.' },
  { n: '04', title: 'Monthly proof report', text: 'The same format as our case studies: before, after, and the screenshot for each.' },
];
---

<Base title={site.name}>
  <!-- Hero -->
  <section class="container-x grid items-center gap-12 pt-14 pb-20 lg:grid-cols-[1.05fr_1fr] lg:pt-20">
    <div>
      <p class="eyebrow">Digital marketing · {site.city}</p>
      <h1 class="mt-4 text-4xl leading-[1.08] font-extrabold tracking-tight sm:text-5xl lg:text-[3.4rem]">
        We don't say we grow local businesses. <span class="text-gradient">We show you.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-ink-soft">
        Emporia helps {site.city} businesses get found on Google and turn that visibility into calls, walk-ins and revenue. Every result on this site comes with the original numbers behind it.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={url('/case-studies/')} class="btn-primary">See the results <Icon name="arrow" class="size-4" /></a>
        <a href={url('/contact/')} class="btn-secondary">Get a free local audit</a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
        <li class="flex items-center gap-1.5"><Icon name="check" class="size-4 text-good" /> Based in {site.city}</li>
        <li class="flex items-center gap-1.5"><Icon name="check" class="size-4 text-good" /> Monthly proof reports</li>
        <li class="flex items-center gap-1.5"><Icon name="check" class="size-4 text-good" /> Reply within a day</li>
      </ul>
    </div>

    {
      featured && (
        <a href={url(`/case-studies/${featured.id}/`)} class="card group block p-6 shadow-xl shadow-ink/5 sm:p-7">
          <div class="flex items-center justify-between text-xs text-muted">
            <span class="font-semibold text-ink">{featured.data.client}</span>
            <span>{featured.data.industry} · {featured.data.location}</span>
          </div>
          <div class="mt-6 grid grid-cols-3 gap-3 border-b border-line pb-6">
            {featured.data.metrics.slice(0, 3).map((m) => (
              <div>
                <p class="num text-2xl font-bold tracking-tight sm:text-3xl">{m.after}</p>
                <p class="mt-1 text-xs text-muted">{m.label}</p>
                <p class="num mt-0.5 text-xs text-muted">from {m.before}</p>
              </div>
            ))}
          </div>
          <p class="mt-5 font-semibold leading-snug">{featured.data.headline}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand">
            See the evidence <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-0.5" />
          </span>
          {featured.data.sample && <p class="mt-4 rounded-lg bg-warn-tint px-3 py-2 text-xs font-medium text-warn">Sample layout — real client data coming soon</p>}
        </a>
      )
    }
  </section>

  <!-- Principles -->
  <section class="border-y border-line bg-mist py-16">
    <div class="container-x">
      <div class="flex items-center gap-2 text-brand"><Icon name="shield" class="size-5" /><p class="eyebrow">How we prove our work</p></div>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight">What we show you is exactly what the client sees.</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          principles.map((p, i) => (
            <div>
              <p class="num text-sm font-semibold text-muted">0{i + 1}</p>
              <h3 class="mt-2 text-lg font-bold">{p.title}</h3>
              <p class="mt-2 text-ink-soft">{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured case study -->
  {
    featured && (
      <section class="container-x py-20">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="eyebrow">Featured case study</p>
            <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight">{featured.data.headline}</h2>
          </div>
          <a href={url(`/case-studies/${featured.id}/`)} class="btn-secondary">Read the full case <Icon name="arrow" class="size-4" /></a>
        </div>
        {featured.data.revenue && (
          <div class="mt-10">
            <RevenueChart {...featured.data.revenue} />
          </div>
        )}
        {others.length > 0 && (
          <div class="mt-10 grid gap-5 md:grid-cols-3">
            {others.map((e) => <CaseStudyCard entry={e} />)}
          </div>
        )}
      </section>
    )
  }

  <!-- Industries -->
  <section class="container-x pb-20">
    <div class="card grid gap-8 p-8 sm:p-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="eyebrow">Who we work with</p>
        <h2 class="mt-3 text-2xl font-bold tracking-tight">Not one industry. One city.</h2>
        <p class="mt-3 text-ink-soft">We work with all kinds of local businesses in and around {site.city}.</p>
      </div>
      <ul class="flex flex-wrap content-center gap-3">
        {
          industries.map((i) => (
            <li>
              <a href={url(`/case-studies/?industry=${encodeURIComponent(i)}`)} class="block rounded-full border border-line px-4 py-2 text-sm font-medium hover:border-ink">{i}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- How we work -->
  <section class="border-y border-line bg-mist py-20">
    <div class="container-x">
      <p class="eyebrow">How we work</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight">Simple, and you always know where you stand.</h2>
      <ol class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s) => (
            <li class="card p-6">
              <p class="num text-sm font-bold text-brand">{s.n}</p>
              <h3 class="mt-3 font-bold">{s.title}</h3>
              <p class="mt-2 text-sm text-ink-soft">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Services -->
  <section class="container-x py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Services</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight">What we do</h2>
      </div>
      <a href={url('/services/')} class="btn-secondary">All services <Icon name="arrow" class="size-4" /></a>
    </div>
    <div class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <a href={url(`/services/#${s.slug}`)} class="bg-white p-6 transition-colors hover:bg-mist">
            <h3 class="font-bold">{s.title}</h3>
            <p class="mt-2 text-sm text-ink-soft">{s.summary}</p>
          </a>
        ))
      }
      <a href={url('/contact/')} class="flex flex-col justify-between bg-ink p-6 text-white">
        <h3 class="font-bold">Not sure what you need?</h3>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold">Start with a free audit <Icon name="arrow" class="size-4" /></span>
      </a>
    </div>
  </section>

  <!-- Lead form -->
  <section id="audit" class="container-x">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <p class="eyebrow">Free local audit</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight">Find out where you stand on Google — free.</h2>
        <p class="mt-4 text-ink-soft">Tell us about your business. We'll send you a short audit of your Google Maps ranking, your profile, and your top competitors nearby.</p>
        <div class="mt-8 space-y-3">
          <a href={whatsappLink()} target="_blank" rel="noopener" class="flex items-center gap-3 rounded-xl border border-line p-4 hover:border-ink">
            <span class="flex size-10 items-center justify-center rounded-full bg-[#1faa53] text-white"><Icon name="whatsapp" class="size-5" /></span>
            <span><span class="block font-semibold">WhatsApp</span><span class="block text-sm text-muted">Message or call us on WhatsApp</span></span>
          </a>
          <a href={telLink} class="flex items-center gap-3 rounded-xl border border-line p-4 hover:border-ink">
            <span class="flex size-10 items-center justify-center rounded-full bg-ink text-white"><Icon name="phone" class="size-5" /></span>
            <span><span class="block font-semibold">Call</span><span class="num block text-sm text-muted">{site.contact.phoneDisplay}</span></span>
          </a>
          <a href={mailLink} class="flex items-center gap-3 rounded-xl border border-line p-4 hover:border-ink">
            <span class="flex size-10 items-center justify-center rounded-full bg-brand text-white"><Icon name="mail" class="size-5" /></span>
            <span><span class="block font-semibold">Email</span><span class="block text-sm text-muted">{site.contact.email}</span></span>
          </a>
        </div>
      </div>
      <LeadForm id="home-lead" />
    </div>
  </section>
</Base>
