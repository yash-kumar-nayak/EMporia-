---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found" noindex>
  <section class="container-x py-28 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight">This page doesn't exist.</h1>
    <p class="mt-4 text-ink-soft">It may have moved. Try one of these instead:</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={url('/')} class="btn-primary">Home</a>
      <a href={url('/case-studies/')} class="btn-secondary">Case studies</a>
      <a href={url('/contact/')} class="btn-secondary">Contact</a>
    </div>
  </section>
</Base>
